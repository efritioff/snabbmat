# ---------------------------------------------------------------------------
# Shared environment variables for docker compose.
# For a real production system these would be secrets, NOT committed to git.
# For this school project we keep them here so the whole stack starts with
# a single command.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=snabbmat
POSTGRES_PASSWORD=snabbmat
POSTGRES_DB=snabbmat

# RabbitMQ
RABBITMQ_DEFAULT_USER=snabbmat
RABBITMQ_DEFAULT_PASS=snabbmat
